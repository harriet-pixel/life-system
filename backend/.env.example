# Deployment-only configuration. No provider API keys belong here.
AI_ISSUER=https://login.example.invalid/
AI_AUDIENCE=life-system-ai
AI_JWKS_URL=https://login.example.invalid/.well-known/jwks.json
AI_SCOPE=life:ai
